<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Infrastructure Situational Awareness Platform
    </title>

    <link
        rel="icon"
        href="favicon.ico"
    >

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
    >

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
    >

    <link
        rel="stylesheet"
        href="style.css"
    >
</head>


<body>

<div id="map"></div>


<!-- =====================================================
     COMMAND PANEL
===================================================== -->

<aside class="command-panel">


    <!-- HEADER -->

    <div class="brand-row">

        <div>

            <div class="eyebrow">
                GEO INTELLIGENCE
            </div>

            <h1>
                Infrastructure Monitor
            </h1>

        </div>


        <div class="status-column">

            <div
                id="systemStatus"
                class="status-badge online"
            >
                ONLINE
            </div>

            <div
                id="dataSourceStatus"
                class="live-source"
            >
                USGS LIVE
            </div>

        </div>

    </div>


    <!-- SEARCH -->

    <div class="control-section">

        <label for="searchBox">
            SEARCH ASSETS
        </label>

        <input
            id="searchBox"
            type="text"
            placeholder="Search infrastructure..."
            autocomplete="off"
        >

    </div>


    <!-- INFRA TYPE FILTER -->

    <div class="control-section">

        <label for="typeFilter">
            INFRASTRUCTURE TYPE
        </label>

        <select id="typeFilter">

            <option value="all">
                All Infrastructure
            </option>

        </select>

    </div>


    <!-- RISK FILTER -->

    <div class="control-section">

        <label for="riskFilter">
            ESTIMATED RISK
        </label>

        <select id="riskFilter">

            <option value="all">
                All Risk Levels
            </option>

            <option value="critical">
                Critical
            </option>

            <option value="high">
                High
            </option>

            <option value="medium">
                Medium
            </option>

            <option value="low">
                Low
            </option>

        </select>

    </div>


    <!-- KPI GRID -->

    <div class="kpi-grid">

        <div class="kpi-card">

            <span>
                Infrastructure
            </span>

            <strong id="totalInfrastructure">
                0
            </strong>

        </div>


        <div class="kpi-card earthquake-card">

            <span>
                Live Earthquakes
            </span>

            <strong id="liveEarthquakes">
                0
            </strong>

        </div>


        <div class="kpi-card affected-card">

            <span>
                Affected Assets
            </span>

            <strong id="affectedAssets">
                0
            </strong>

        </div>


        <div class="kpi-card risk-card">

            <span>
                High Risk
            </span>

            <strong id="highRisk">
                0
            </strong>

        </div>


        <div class="kpi-card critical-card">

            <span>
                Critical Events
            </span>

            <strong id="criticalEvents">
                0
            </strong>

        </div>


        <div class="kpi-card">

            <span>
                Feed
            </span>

            <strong
                id="feedStatus"
                class="feed-value"
            >
                LIVE
            </strong>

        </div>

    </div>



    <!-- =================================================
         PHASE 6.3 SENSOR HEALTH + ALERTS
    ================================================== -->

    <section class="panel-section sensor-health-section">

        <div class="section-title-row">

            <div class="section-title">
                PHASE 6.3 SENSOR HEALTH
            </div>

            <div
                id="alertSocketIndicator"
                class="alert-socket-indicator connecting"
            >
                CONNECTING
            </div>

        </div>

        <div class="sensor-health-grid">

            <div class="sensor-health-card">
                <span>Monitored</span>
                <strong id="monitoredSensors">0</strong>
            </div>

            <div class="sensor-health-card online">
                <span>Online</span>
                <strong id="onlineSensors">0</strong>
            </div>

            <div class="sensor-health-card degraded">
                <span>Degraded</span>
                <strong id="degradedSensors">0</strong>
            </div>

            <div class="sensor-health-card offline">
                <span>Offline</span>
                <strong id="offlineSensors">0</strong>
            </div>

            <div class="sensor-health-card">
                <span>Avg Health</span>
                <strong id="averageSensorHealth">0%</strong>
            </div>

            <div class="sensor-health-card alerts">
                <span>Active Alerts</span>
                <strong id="activeAlertsCount">0</strong>
            </div>

        </div>

        <div class="alert-summary-grid">
            <div class="alert-summary-item critical">
                <span>Critical</span>
                <strong id="criticalAlertCount">0</strong>
            </div>

            <div class="alert-summary-item high">
                <span>High</span>
                <strong id="highAlertCount">0</strong>
            </div>

            <div class="alert-summary-item medium">
                <span>Medium</span>
                <strong id="mediumAlertCount">0</strong>
            </div>

            <div class="alert-summary-item low">
                <span>Low</span>
                <strong id="lowAlertCount">0</strong>
            </div>
        </div>

        <div class="alerts-subtitle">
            ACTIVE SENSOR ALERTS
        </div>

        <div
            id="alertFeed"
            class="alert-feed"
        >
            <div class="empty-state">
                Loading local sensor alerts...
            </div>
        </div>

    </section>


    <!-- =================================================
         PHASE 6.4 TELEMETRY HISTORY
    ================================================== -->

    <section class="panel-section telemetry-history-section">

        <div class="section-title-row">

            <div class="section-title">
                PHASE 6.4 TELEMETRY HISTORY
            </div>

            <div
                id="telemetryHistoryStatus"
                class="history-status ready"
            >
                READY
            </div>

        </div>

        <div class="history-control">

            <label for="historyAsset">
                INFRASTRUCTURE ASSET
            </label>

            <select id="historyAsset">
                <option value="">
                    Select infrastructure...
                </option>
            </select>

        </div>

        <div class="history-toolbar">

            <div class="history-control">
                <label for="historyRange">
                    TIME RANGE
                </label>

                <select id="historyRange">
                    <option value="1">Last 1 hour</option>
                    <option value="6">Last 6 hours</option>
                    <option value="24" selected>Last 24 hours</option>
                    <option value="168">Last 7 days</option>
                </select>
            </div>

            <button
                id="refreshHistory"
                class="history-refresh-button"
                type="button"
            >
                Refresh
            </button>

        </div>

        <div
            id="historySummary"
            class="history-summary-grid"
        >
            <div class="history-summary-card">
                <span>Samples</span>
                <strong id="historySamples">0</strong>
            </div>

            <div class="history-summary-card">
                <span>Avg Health</span>
                <strong id="historyAvgHealth">--</strong>
            </div>

            <div class="history-summary-card">
                <span>Avg CPU</span>
                <strong id="historyAvgCpu">--</strong>
            </div>

            <div class="history-summary-card">
                <span>Avg Temp</span>
                <strong id="historyAvgTemp">--</strong>
            </div>
        </div>

        <div
            id="telemetryHistoryEmpty"
            class="empty-state history-empty-state"
        >
            Select an infrastructure asset to load persisted telemetry history.
        </div>

        <div
            id="telemetryCharts"
            class="telemetry-charts hidden"
        >

            <div class="telemetry-chart-card">
                <div class="telemetry-chart-header">
                    <span>Health</span>
                    <strong id="historyHealthLatest">--</strong>
                </div>
                <div id="healthHistoryChart" class="telemetry-chart"></div>
            </div>

            <div class="telemetry-chart-card">
                <div class="telemetry-chart-header">
                    <span>CPU</span>
                    <strong id="historyCpuLatest">--</strong>
                </div>
                <div id="cpuHistoryChart" class="telemetry-chart"></div>
            </div>

            <div class="telemetry-chart-card">
                <div class="telemetry-chart-header">
                    <span>Temperature</span>
                    <strong id="historyTempLatest">--</strong>
                </div>
                <div id="temperatureHistoryChart" class="telemetry-chart"></div>
            </div>

            <div class="telemetry-chart-card">
                <div class="telemetry-chart-header">
                    <span>Latency</span>
                    <strong id="historyLatencyLatest">--</strong>
                </div>
                <div id="latencyHistoryChart" class="telemetry-chart"></div>
            </div>

            <div class="telemetry-chart-card">
                <div class="telemetry-chart-header">
                    <span>Packet Loss</span>
                    <strong id="historyPacketLossLatest">--</strong>
                </div>
                <div id="packetLossHistoryChart" class="telemetry-chart"></div>
            </div>

        </div>

    </section>

    <!-- =================================================
         PHASE 6.1 TEST MODE
    ================================================== -->

    <section class="panel-section test-section">

        <div class="section-title-row">

            <div class="section-title">
                PHASE 6.1 TEST MODE
            </div>

            <div
                id="testModeIndicator"
                class="test-indicator inactive"
            >
                OFF
            </div>

        </div>


        <div class="test-warning">

            Simulated events are clearly marked
            as TEST and are never treated as
            real USGS earthquakes.

        </div>


        <div class="test-control">

            <label for="testAsset">
                TARGET INFRASTRUCTURE
            </label>

            <select id="testAsset">

                <option value="">
                    Select infrastructure...
                </option>

            </select>

        </div>


        <div class="test-grid">

            <div class="test-control">

                <label for="testMagnitude">
                    MAGNITUDE
                </label>

                <input
                    id="testMagnitude"
                    type="number"
                    min="2.5"
                    max="9.5"
                    step="0.1"
                    value="6.2"
                >

            </div>


            <div class="test-control">

                <label for="testRadius">
                    RADIUS KM
                </label>

                <input
                    id="testRadius"
                    type="number"
                    min="1"
                    max="2000"
                    step="1"
                    value="200"
                >

            </div>

        </div>


        <button
            id="createTestEvent"
            class="test-button create-button"
            type="button"
        >
            Create Test Earthquake
        </button>


        <button
            id="removeTestEvent"
            class="test-button remove-button"
            type="button"
            disabled
        >
            Remove Test Earthquake
        </button>


        <div
            id="testEventStatus"
            class="test-status"
        >
            No simulated event active.
        </div>

    </section>


    <!-- ASSET DISTRIBUTION -->

    <section class="panel-section">

        <div class="section-title">
            ASSET DISTRIBUTION
        </div>

        <div id="typeStats">
            Loading...
        </div>

    </section>


    <!-- EXPOSED INFRASTRUCTURE -->

    <section class="panel-section">

        <div class="section-title-row">

            <div class="section-title">
                EXPOSED INFRASTRUCTURE
            </div>

            <span class="warning-dot"></span>

        </div>


        <div
            id="riskFeed"
            class="event-feed"
        >
            Loading risk data...
        </div>

    </section>


    <!-- LIVE EARTHQUAKES -->

    <section class="panel-section">

        <div class="section-title-row">

            <div class="section-title">
                LIVE / TEST EARTHQUAKES
            </div>

            <span class="live-dot"></span>

        </div>


        <div
            id="eventFeed"
            class="event-feed"
        >
            Loading earthquake feed...
        </div>

    </section>

</aside>


<!-- =====================================================
     MAP LEGEND
===================================================== -->

<div class="map-legend">

    <div class="legend-title">
        INFRASTRUCTURE
    </div>


    <div class="legend-row">

        <span>
            <i class="legend-dot cloud"></i>
            Cloud
        </span>

        <span>
            <i class="legend-dot education"></i>
            Education
        </span>

        <span>
            <i class="legend-dot healthcare"></i>
            Healthcare
        </span>

        <span>
            <i class="legend-dot transport"></i>
            Transport
        </span>

        <span>
            <i class="legend-dot telecom"></i>
            Telecom
        </span>

    </div>


    <div class="legend-title risk-legend-title">
        ESTIMATED EXPOSURE
    </div>


    <div class="legend-row">

        <span>
            <i class="legend-dot risk-medium"></i>
            Medium
        </span>

        <span>
            <i class="legend-dot risk-high"></i>
            High
        </span>

        <span>
            <i class="legend-dot risk-critical"></i>
            Critical
        </span>

    </div>


    <div class="legend-title earthquake-legend-title">
        EVENT SOURCE
    </div>


    <div class="legend-row">

        <span>
            <i class="legend-dot quake"></i>
            USGS
        </span>

        <span>
            <i class="legend-dot test-quake"></i>
            TEST
        </span>

    </div>

</div>


<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>

<script
    src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
></script>

<script src="app.js"></script>

</body>

</html>
